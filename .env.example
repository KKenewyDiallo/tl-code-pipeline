MISTRAL_API_KEY=
# JIRA (connecteur MCP atlassian) — optionnel, défauts adaptés à toollive :
# jira_base_url=https://toollive.atlassian.net/jira
# jira_cloud_id=                  # UUID du site ou host (ex. toollive.atlassian.net)
# jira_transition_start=In Progress   # transition au démarrage du run sur le ticket
# jira_transition_review=code-review  # transition à l'ouverture de la MR
# jira_transition_done=               # transition finale (vide = aucune)
# jira_connector_name=01a1ef49-c29a-73e1-a6b8-17310e9de9a7   # ID/nom du connecteur MCP JIRA
#                                     # (défaut : connecteur workspace atlassian_94e0,
#                                     #  serveur https://mcp.atlassian.com/v2/mcp)
# jira_credentials_name=              # credential épinglé par nom ; vide = credential par
#                                     # défaut du caller (user, puis workspace, puis org)
